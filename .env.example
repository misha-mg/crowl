# Required: create a bot with @BotFather. Numeric owner ID, not @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Optional. Full access is the requested default.
DEFAULT_PROVIDER=codex
DEFAULT_PERMISSION_MODE=full
VOICE_ENABLED=true
# Shared project files: serialize by default. Values >1 explicitly allow concurrent writes.
MAX_CONCURRENT_SESSIONS=1
# Absolute overrides; otherwise PATH and standard macOS locations are searched.
CLAUDE_BIN=
CODEX_BIN=
WHISPER_BIN=
WHISPER_MODEL_PATH=
FFMPEG_BIN=
